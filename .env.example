# --- Language model (any LangChain provider; install the matching extra) ---------
# pip install -e ".[gemini]"  -> google_genai:gemini-2.5-flash  (needs GOOGLE_API_KEY)
# pip install -e ".[groq]"    -> groq:llama-3.3-70b-versatile    (needs GROQ_API_KEY)
# pip install -e ".[openai]"  -> openai:gpt-4.1-mini             (needs OPENAI_API_KEY)
LLM_MODEL=google_genai:gemini-2.5-flash
GOOGLE_API_KEY=
LLM_CALLS_PER_MINUTE=30

# --- Company -----------------------------------------------------------------------
COMPANY_NAME=Parcelo
SUPPORT_ADDRESS=support@parcelo.example
REPLY_SIGNATURE=Kind regards,\nThe Parcelo Support Team
ALLOWED_LINK_DOMAINS=parcelo.example

# --- Policy ------------------------------------------------------------------------
MIN_CONFIDENCE=0.6
MAX_DRAFT_ATTEMPTS=3
# draft = leave Gmail drafts for a human (recommended); send = auto-send the safe subset
DELIVERY_MODE=draft
AUTO_SEND_CATEGORIES=tracking_inquiry
AUTO_SEND_MIN_CONFIDENCE=0.9

# --- Data ----------------------------------------------------------------------------
KNOWLEDGE_DIR=knowledge
PARCELS_FILE=data/parcels.json
METRICS_DB=.mailpilot/metrics.sqlite3
MINUTES_SAVED_PER_DRAFT=4

# --- Gmail -----------------------------------------------------------------------------
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_QUERY=in:inbox newer_than:2d -from:me -category:promotions

# --- HTTP API (required for `mailpilot serve`, at least 16 characters) ------------------
MAILPILOT_API_KEY=
